#!/usr/bin/env python3
"""bridge: two agents correspond by letters. See CONCEPT.md.

    bridge join claude|codex     # inside that session: publish its door
    bridge open [--limit N]      # a human, outside both sessions: an exchange of at most N letters
    bridge send codex "text"     # a letter from claude to codex; "-" reads the body from stdin
    bridge read [N]              # the ledger, or its last N records
"""
import argparse
import fcntl
import json
import os
import socket
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path

LEDGER = Path(os.environ.get("BRIDGE_LEDGER", "~/.bridge/ledger.jsonl")).expanduser()
CODEX = os.environ.get("BRIDGE_CODEX", "/Applications/ChatGPT.app/Contents/Resources/codex")
PEERS = {"claude", "codex"}
SESSION = {  # door field -> the variable each vendor exports inside its own session
    "claude": {"socket": "CLAUDE_CODE_MESSAGING_SOCKET", "token": "CLAUDE_CODE_MESSAGING_TOKEN"},
    "codex": {"thread": "CODEX_SESSION_ID"},
}


def fail(why):
    sys.exit(f"bridge: {why}")


# ledger ---------------------------------------------------------------------

def records():
    return [json.loads(line) for line in LEDGER.read_text().splitlines() if line] if LEDGER.exists() else []


def record(kind, **fields):
    return {"n": len(records()) + 1, "at": time.strftime("%Y-%m-%dT%H:%M:%S"), "kind": kind, **fields}


@contextmanager
def ledger():
    """The ledger held exclusively; yields the function that appends one record."""
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield lambda rec: f.write(json.dumps(rec) + "\n")


def budget():
    """Letters left in the open exchange; None when no exchange is open."""
    sent = 0
    for rec in reversed(records()):
        if rec["kind"] == "open":
            return rec["limit"] - sent
        sent += rec["kind"] == "letter"
    return None


# doors ----------------------------------------------------------------------

def inside():
    """The peer whose session this shell runs in, or None for a human's terminal."""
    return next((p for p, vars in SESSION.items() if all(os.environ.get(v) for v in vars.values())), None)


def door(peer):
    joins = [r for r in records() if r["kind"] == "join" and r["peer"] == peer]
    return joins[-1] if joins else fail(f"{peer} has not joined")


def knock_claude(door, text):
    lines = [{"type": "auth", "token": door["token"]},
             {"type": "user", "message": {"role": "user", "content": text}}]
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(door["socket"])
        s.sendall("".join(json.dumps(line) + "\n" for line in lines).encode())


def knock_codex(door, text):
    subprocess.run([CODEX, "queue", "--thread", door["thread"], "--message", text],
                   check=True, stdout=subprocess.DEVNULL)


KNOCK = {"claude": knock_claude, "codex": knock_codex}


def envelope(rec):
    return (f"Letter {rec['n']} from {rec['from']} via bridge. If it needs an answer, reply with:\n"
            f"bridge send {rec['from']} - <<'EOF'\n...\nEOF\n\n{rec['body']}")


# verbs ----------------------------------------------------------------------

def join(peer):
    if inside() != peer:
        fail(f"join {peer} from inside a {peer} session")
    with ledger() as write:
        write(record("join", peer=peer, **{field: os.environ[var] for field, var in SESSION[peer].items()}))
    print(f"{peer} joined")


def open_exchange(limit):
    if inside():
        fail("open is the human's verb; run it outside both sessions")
    with ledger() as write:
        write(record("open", limit=limit))
    print(f"exchange open: {limit} letters")


def send(to, body):
    sender = (PEERS - {to}).pop()
    with ledger() as write:
        left = budget()
        if left is None:
            fail("no exchange is open; a human opens one with `bridge open`")
        if left <= 0:
            fail("the exchange's letters are spent; stop and wait for the human")
        rec = record("letter", **{"from": sender, "to": to, "body": body})
        try:
            KNOCK[to](door(to), envelope(rec))
        except (OSError, subprocess.CalledProcessError) as e:
            fail(f"{to}'s door did not answer ({e}); {to} must `bridge join {to}` again")
        write(rec)
    print(f"letter {rec['n']} delivered to {to}, {left - 1} left")


def read(count):
    rows = records()
    for rec in rows[-count:] if count else rows:
        line = f"{rec['n']:>4}  {rec['at']}  {rec['kind']:<6}"
        if rec["kind"] == "letter":
            print(f"{line} {rec['from']} -> {rec['to']}")
            print("\n".join("      " + l for l in rec["body"].splitlines()))
        elif rec["kind"] == "open":
            print(f"{line} {rec['limit']} letters")
        else:
            print(f"{line} {rec['peer']}")


# cli ------------------------------------------------------------------------

def main(argv=None):
    p = argparse.ArgumentParser(prog="bridge", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="verb", required=True)
    sub.add_parser("join").add_argument("peer", choices=sorted(PEERS))
    sub.add_parser("open").add_argument("--limit", type=int, default=12)
    s = sub.add_parser("send")
    s.add_argument("to", choices=sorted(PEERS))
    s.add_argument("body", help='the text, or "-" to read it from stdin')
    sub.add_parser("read").add_argument("count", nargs="?", type=lambda n: max(int(n), 1))
    a = p.parse_args(argv)
    if a.verb == "join":
        join(a.peer)
    elif a.verb == "open":
        open_exchange(a.limit)
    elif a.verb == "send":
        send(a.to, sys.stdin.read().rstrip("\n") if a.body == "-" else a.body)
    else:
        read(a.count)


if __name__ == "__main__":
    main()
